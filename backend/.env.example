PORT=4000
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
# --- Base de datos PostgreSQL ---
# postgresql://USUARIO:CLAVE@SERVIDOR:PUERTO/NOMBRE_BASE  (la base debe existir: createdb nicolett_studio)
DATABASE_URL=postgresql://postgres:tu_clave@localhost:5432/nicolett_studio
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Correo (recuperacion de contrasena) ---
# Mientras SMTP_PASS este vacio, el sistema usa una cuenta de prueba Ethereal y
# muestra un link de vista previa del correo en la consola del backend.
# Para enviar correos reales con Gmail, pon en SMTP_PASS la "contrasena de
# aplicacion" de la cuenta (ver README > "Correo real con Gmail").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nicolettstudio86@gmail.com
SMTP_PASS=
SMTP_FROM="Nicolett Studio Fantasy <nicolettstudio86@gmail.com>"

# --- Google Calendar (opcional) ---
# Ruta (relativa a backend/) del JSON de la cuenta de servicio de Google Cloud.
# Ver README > "Conectar Google Calendar". Esta carpeta NO se sube a git.
GOOGLE_SERVICE_ACCOUNT_FILE=credenciales/google-service-account.json

# --- Webpay Plus (abono de reservas) ---
# URL publica del backend: Transbank devuelve a la clienta a BACKEND_URL/api/pagos/webpay/retorno
BACKEND_URL=http://localhost:4000
# Solo para PRODUCCION (codigo de comercio y llave secreta que entrega Transbank).
# Si se dejan vacias se usa el ambiente de INTEGRACION (tarjetas de prueba, sin cobros reales).
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# --- Agente de WhatsApp (WhatsApp Cloud API de Meta) ---
# Ver README > "Agente de WhatsApp". Sin WHATSAPP_TOKEN ni WHATSAPP_PHONE_NUMBER_ID
# el agente funciona igual en el simulador del panel (Panel > WhatsApp), sin enviar nada.
# Para que Meta y el celular de la clienta lleguen al backend, BACKEND_URL debe ser
# una URL publica con https (en pruebas, la de ngrok).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palabra secreta que tu eliges y escribes igual en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# "Clave secreta de la app" (Meta > Configuracion de la app > Basica). Comprueba que los avisos vienen de Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Numero del salon en WhatsApp (para el boton "Volver a WhatsApp" despues de pagar), ej. 56940322551
WHATSAPP_NUMERO_PUBLICO=
# Correo que recibe el aviso cuando una clienta pide hablar con una persona (por defecto SMTP_USER)
WHATSAPP_AVISO_EMAIL=
